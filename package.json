{
  "name": "rivet",
  "version": "0.0.1",
  "type": "module",
  "description": "Electron SFTP/WebDAV 文件浏览器",
  "main": "dist/main/app/main.js",
  "author": {
    "name": "RealChuan",
    "url": "https://github.com/RealChuan"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/RealChuan/Rivet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealChuan/Rivet.git"
  },
  "bugs": {
    "url": "https://github.com/RealChuan/Rivet/issues"
  },
  "keywords": [
    "electron",
    "sftp",
    "webdav",
    "file-manager",
    "file-browser",
    "react",
    "vite",
    "tailwindcss"
  ],
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:vite\" \"pnpm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "pnpm run build:vite && pnpm run build:preload && pnpm run build:electron",
    "build:vite": "vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:electron": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --environment node src/main/**/*.test.ts",
    "test:renderer": "vitest run --environment jsdom src/renderer/**/*.test.ts",
    "test:shared": "vitest run --environment node src/shared/**/*.test.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:main",
    "i18n:extract": "pnpm exec i18next-cli extract",
    "package": "pnpm run build && electron-builder --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "ci": "pnpm run format && pnpm run lint:fix && pnpm run typecheck:all && pnpm run test:run && pnpm run i18n:extract && pnpm run build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@sentry/electron": "^7.13.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "ssh2-sftp-client": "^12.1.1",
    "tailwind-merge": "^3.6.0",
    "webdav": "^5.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "i18next-cli": "^1.63.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  },
  "desktopName": "rivet.desktop",
  "build": {
    "appId": "com.rivet.app",
    "productName": "Rivet",
    "asar": true,
    "asarUnpack": "**/*.{node,dll}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "RealChuan",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  }
}
