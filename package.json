{
  "name": "rivet",
  "version": "0.0.1",
  "type": "module",
  "description": "Electron SFTP/WebDAV 文件浏览器",
  "main": ".vite/build/main.js",
  "author": {
    "name": "RealChuan",
    "url": "https://github.com/RealChuan"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/RealChuan/Rivet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealChuan/Rivet.git"
  },
  "bugs": {
    "url": "https://github.com/RealChuan/Rivet/issues"
  },
  "keywords": [
    "electron",
    "sftp",
    "webdav",
    "file-manager",
    "file-browser",
    "react",
    "vite",
    "tailwindcss"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-forge package",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer",
    "test:shared": "vitest run --project shared",
    "test:typecheck": "vitest --config vitest.typecheck.config.ts --typecheck.only run",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --cache --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.renderer.json",
    "typecheck:main": "tsc -p tsconfig.main.json",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:main",
    "i18n:extract": "pnpm exec i18next-cli extract",
    "i18n:types": "pnpm exec i18next-cli types",
    "i18n:check": "pnpm exec i18next-cli extract --ci && pnpm exec i18next-cli types --ci",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "test:e2e": "playwright test",
    "e2e:servers": "docker compose -f e2e/servers/docker-compose.yml up -d",
    "e2e:servers:down": "docker compose -f e2e/servers/docker-compose.yml down -v",
    "package": "electron-forge make",
    "package:win": "pnpm run package:win:x64 && pnpm run package:win:arm64",
    "package:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "package:win:arm64": "electron-forge make --platform=win32 --arch=arm64",
    "package:linux": "pnpm run package:linux:x64 && pnpm run package:linux:arm64",
    "package:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "package:linux:arm64": "electron-forge make --platform=linux --arch=arm64",
    "package:macos": "pnpm run package:macos:x64 && pnpm run package:macos:arm64 && pnpm run package:macos:universal",
    "package:macos:x64": "electron-forge make --platform=darwin --arch=x64",
    "package:macos:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "package:macos:universal": "electron-forge make --platform=darwin --arch=universal",
    "verify": "pnpm run typecheck:all && pnpm run lint && pnpm run test:run && pnpm run test:typecheck && pnpm run i18n:check && pnpm run audit:prod && pnpm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@sentry/electron": "^8.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "fast-xml-parser": "^5.11.2",
    "i18next": "^26.5.11",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-resizable-panels": "^4.15.2",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "i18next-cli": "^1.80.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
