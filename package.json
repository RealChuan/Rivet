{
  "name": "rivet",
  "version": "0.0.1",
  "type": "module",
  "description": "Electron SFTP/WebDAV 文件浏览器",
  "main": ".vite/build/main.js",
  "author": {
    "name": "RealChuan",
    "url": "https://github.com/RealChuan"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/RealChuan/Rivet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealChuan/Rivet.git"
  },
  "bugs": {
    "url": "https://github.com/RealChuan/Rivet/issues"
  },
  "keywords": [
    "electron",
    "sftp",
    "webdav",
    "file-manager",
    "file-browser",
    "react",
    "vite",
    "tailwindcss"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --environment node src/main/**/*.test.ts",
    "test:renderer": "vitest run --environment jsdom src/renderer/**/*.test.ts",
    "test:shared": "vitest run --environment node src/shared/**/*.test.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:main",
    "i18n:extract": "pnpm exec i18next-cli extract",
    "package": "electron-forge make",
    "package:win": "pnpm run package:win:x64 && pnpm run package:win:arm64",
    "package:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "package:win:arm64": "electron-forge make --platform=win32 --arch=arm64",
    "package:linux": "pnpm run package:linux:x64 && pnpm run package:linux:arm64",
    "package:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "package:linux:arm64": "electron-forge make --platform=linux --arch=arm64",
    "package:mac": "pnpm run package:mac:x64 && pnpm run package:mac:arm64 && pnpm run package:mac:universal",
    "package:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "package:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "package:mac:universal": "electron-forge make --platform=darwin --arch=universal",
    "ci": "pnpm run format && pnpm run lint:fix && pnpm run typecheck:all && pnpm run test:run && pnpm run i18n:extract && pnpm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-select": "^2.3.1",
    "@sentry/electron": "^7.14.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "i18next": "^26.3.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.11.2",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "ssh2-sftp-client": "^12.1.1",
    "tailwind-merge": "^3.6.0",
    "webdav": "^5.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^42.5.0",
    "eslint": "^10.5.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "i18next-cli": "^1.64.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
