{
  "name": "rivet",
  "version": "0.0.1",
  "type": "module",
  "description": "Electron SFTP/WebDAV 文件浏览器",
  "main": "dist/main/app/main.js",
  "author": {
    "name": "RealChuan",
    "url": "https://github.com/RealChuan"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/RealChuan/Rivet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealChuan/Rivet.git"
  },
  "bugs": {
    "url": "https://github.com/RealChuan/Rivet/issues"
  },
  "keywords": [
    "electron",
    "sftp",
    "webdav",
    "file-manager",
    "file-browser",
    "react",
    "vite",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:preload && npm run build:electron",
    "build:vite": "vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:electron": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "lint": "cross-env NODE_ENV=development eslint src --ext .ts,.tsx",
    "lint:fix": "cross-env NODE_ENV=development eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:main",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "i18n:extract": "npx i18next-cli extract",
    "ci": "npm run format && npm run typecheck:all && npm run lint && npm run i18n:extract && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "i18next": "^26.1.0",
    "keytar": "^7.9.0",
    "module-alias": "^2.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.15.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^14.0.0",
    "webdav": "^5.10.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-cli": "^1.56.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "ssh2": {
      "cpu-features": "npm:empty-npm-package@1.0.0"
    }
  },
  "build": {
    "appId": "com.rivet.app",
    "productName": "Rivet",
    "asar": true,
    "asarUnpack": "**/*.{node,dll}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "RealChuan"
    },
    "mac": {
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  }
}
